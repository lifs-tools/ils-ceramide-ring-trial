{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lipidcompass.org/schemas/summarized-study-result-v1.json",
  "title": "Summarized Study Result Schema",
  "description": "Schema for importing summarized study results (ring trials, comparative studies) into LipidCompass. This schema describes the JSON structure for bootstrap data import.",
  "type": "object",
  "required": ["title", "description", "studyDesign", "lipidSummarizedQuantities"],
  "additionalProperties": false,
  "properties": {
    "nativeId": {
      "type": "string",
      "description": "A unique identifier for this study result, typically from the source database. Used to check for existing records during import.",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "description": "Human-readable title of the study. Must be unique for import deduplication.",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "description": "Description of the study and its objectives.",
      "minLength": 1
    },
    "studyDesign": {
      "type": "object",
      "description": "The study design type, using OBI ontology controlled vocabulary parameter. References terms like OBI:0003658 (ring trial design), OBI:0002624 (case control study design), etc.",
      "required": ["accession", "name", "value"],
      "additionalProperties": false,
      "properties": {
        "accession": {
          "type": "string",
          "description": "The CV term accession (e.g., 'OBI:0003658' for ring trial design).",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "description": "The name of the CV parameter (e.g., 'study design type').",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "description": "The value of the CV parameter (e.g., 'ring trial design').",
          "minLength": 1
        },
        "cvLabel": {
          "type": "string",
          "description": "Optional: The controlled vocabulary label (e.g., 'OBI').",
          "minLength": 1
        }
      }
    },
    "publicationMetadata": {
      "type": "object",
      "description": "Publication metadata for the associated publication. All fields are optional.",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "description": "Title of the publication."
        },
        "authors": {
          "type": "array",
          "description": "List of author names.",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "year": {
          "type": "integer",
          "description": "Publication year.",
          "minimum": 1900,
          "maximum": 2100
        },
        "doi": {
          "type": "string",
          "description": "Digital Object Identifier for the publication.",
          "pattern": "^10\\..*"
        },
        "description": {
          "type": "string",
          "description": "Additional description of the publication."
        }
      }
    },
    "lipidSummarizedQuantities": {
      "type": "array",
      "description": "List of lipid quantity data points for this study. Each entry represents a unique combination of lipid(s), grouping attributes, and quantity measurements.",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["lipids", "quantityUnit"],
        "additionalProperties": false,
        "properties": {
          "lipids": {
            "type": "array",
            "description": "List of lipid identifiers. Typically contains a single lipid, but may contain multiple if the lipids cannot be disambiguated (e.g., isobaric species). Each item should be a lipid name, shorthand notation, or identifier.",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "quantityUnit": {
            "type": "object",
            "description": "The controlled vocabulary parameter describing the unit of the quantity values.",
            "required": ["accession", "name"],
            "additionalProperties": false,
            "properties": {
              "accession": {
                "type": "string",
                "description": "The CV term accession for the unit (e.g., 'UO:0000008' for picomole).",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "description": "The name of the unit (e.g., 'picomole').",
                "minLength": 1
              },
              "value": {
                "type": "string",
                "description": "Optional: The value associated with the unit."
              },
              "cvLabel": {
                "type": "string",
                "description": "Optional: The controlled vocabulary label (e.g., 'UO')."
              }
            }
          },
          "nativeQuantityUnit": {
            "type": "object",
            "description": "Optional: The controlled vocabulary parameter describing the native/original unit of the quantity values before any conversion.",
            "required": ["accession", "name"],
            "additionalProperties": false,
            "properties": {
              "accession": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": "string"
              },
              "cvLabel": {
                "type": "string"
              }
            }
          },
          "cvParameters": {
            "type": "array",
            "description": "Optional: Additional controlled vocabulary parameters associated with this quantity data.",
            "items": {
              "type": "object",
              "required": ["accession", "name"],
              "additionalProperties": false,
              "properties": {
                "accession": {
                  "type": "string",
                  "minLength": 1
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "value": {
                  "type": "string"
                },
                "cvLabel": {
                  "type": "string"
                }
              }
            }
          },
          "groupingAttributes": {
            "type": "object",
            "description": "Optional: Grouping attributes that define the context for this quantity data. Keys are attribute names (e.g., 'labId', 'tissue', 'biologicalSpecies', 'sampleMatrix'). Values are CV parameter objects describing the specific attribute value. This allows flexible grouping for different study types.",
            "additionalProperties": {
              "type": "object",
              "required": ["accession", "name"],
              "properties": {
                "accession": {
                  "type": "string",
                  "minLength": 1
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "value": {
                  "type": "string"
                },
                "cvLabel": {
                  "type": "string"
                }
              }
            }
          },
          "individualMeasurements": {
            "type": "array",
            "description": "Optional: Individual measurements, including replicates, with optional per-measurement metadata. If present, contains the raw data points; may be empty if only statistics are provided.",
            "items": {
              "type": "object",
              "required": ["quantity"],
              "additionalProperties": false,
              "properties": {
                "quantity": {
                  "type": "number",
                  "description": "The measured quantity value."
                },
                "attributes": {
                  "type": "object",
                  "description": "Optional: Per-replicate metadata as a map of attribute names to CV parameter values. Keys could include: replicateId, batchId, timestamp, technicalReplicate, biologicalReplicate, etc.",
                  "additionalProperties": {
                    "type": "object",
                    "required": ["accession", "name"],
                    "properties": {
                      "accession": {
                        "type": "string",
                        "minLength": 1
                      },
                      "name": {
                        "type": "string",
                        "minLength": 1
                      },
                      "value": {
                        "type": "string"
                      },
                      "cvLabel": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "stats": {
            "type": "object",
            "description": "Optional: Pre-computed statistical summary for the quantity data. May be null if only raw measurements are provided (stats can be computed from individualMeasurements). All fields are optional to support studies that report partial statistics.",
            "additionalProperties": false,
            "properties": {
              "n": {
                "type": "integer",
                "description": "Number of measurements.",
                "minimum": 0
              },
              "mean": {
                "type": "number",
                "description": "Arithmetic mean of the measurements."
              },
              "sd": {
                "type": "number",
                "description": "Standard deviation of the measurements."
              },
              "median": {
                "type": "number",
                "description": "Median of the measurements."
              },
              "cv": {
                "type": "number",
                "description": "Coefficient of variation (CV = sd/mean * 100)."
              },
              "rcv": {
                "type": "number",
                "description": "Relative coefficient of variation."
              },
              "min": {
                "type": "number",
                "description": "Minimum value in the measurements."
              },
              "max": {
                "type": "number",
                "description": "Maximum value in the measurements."
              },
              "sum": {
                "type": "number",
                "description": "Sum of all measurements."
              },
              "variance": {
                "type": "number",
                "description": "Variance of the measurements."
              }
            }
          }
        }
      }
    },
    "transactionUuid": {
      "type": "string",
      "description": "Optional: Transaction UUID for the import. If not provided, will be generated during import.",
      "minLength": 1
    },
    "visibility": {
      "type": "string",
      "description": "Optional: Visibility setting for the study result. Defaults to 'PUBLIC' if not specified.",
      "enum": ["PUBLIC", "PRIVATE"],
      "default": "PUBLIC"
    }
  }
}