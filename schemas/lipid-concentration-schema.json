{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LipidConcentrationDataset",
  "description": "Schema for representing lipid concentration measurements with consensus values across labs and filtered outliers",
  "type": "object",
  "required": ["publicationMetadata", "data"],
  "properties": {
    "publicationMetadata": {
      "type": "object",
      "description": "Publication and dataset metadata",
      "required": ["title", "authors", "year", "doi", "description"],
      "properties": {
        "title": {
          "type": "string",
          "description": "Title of the associated publication"
        },
        "authors": {
          "type": "array",
          "description": "List of authors",
          "items": {
            "type": "string"
          }
        },
        "year": {
          "type": "integer",
          "description": "Year of publication",
          "minimum": 1900,
          "maximum": 2100
        },
        "doi": {
          "type": "string",
          "description": "DOI link to the publication",
          "format": "uri"
        },
        "description": {
          "type": "string",
          "description": "Description of what this dataset describes/shows"
        }
      }
    },
    "data": {
      "type": "array",
      "description": "Array of lipid concentration measurements by sample matrix",
      "items": {
        "type": "object",
        "required": ["sample_matrix", "lipid", "all", "filtered"],
        "properties": {
          "sample_matrix": {
            "type": "string",
            "description": "Sample material (e.g., SRM, hTAG, DB, YAA)",
            "enum": ["SRM", "hTAG", "DB", "YAA"]
          },
          "lipid": {
            "type": "string",
            "description": "Lipid name in format 'Cer X:Y;OZ/A:B' or other lipid nomenclature",
            "pattern": "^.+$"
          },
          "all": {
            "type": "object",
            "description": "Consensus concentration values across all labs",
            "required": ["n", "mean", "sd", "median", "cv", "rcv"],
            "properties": {
              "n": {
                "type": "integer",
                "description": "Total number of contributing measurements",
                "minimum": 1
              },
              "mean": {
                "type": "number",
                "description": "Mean concentration in μmol/L"
              },
              "sd": {
                "type": "number",
                "description": "Standard deviation of measurement concentrations in μmol/L"
              },
              "median": {
                "type": "number",
                "description": "Median concentration in μmol/L"
              },
              "cv": {
                "type": "number",
                "description": "Coefficient of Variation percentage",
                "minimum": 0
              },
              "rcv": {
                "type": "number",
                "description": "Percent Reference Change Value",
                "minimum": 0
              }
            }
          },
          "filtered": {
            "type": "object",
            "description": "Consensus concentration values with outliers removed",
            "required": ["n", "mean", "sd", "median", "cv", "rcv"],
            "properties": {
              "n": {
                "type": "integer",
                "description": "Number of contributing measurements after outlier removal",
                "minimum": 1
              },
              "mean": {
                "type": "number",
                "description": "Mean concentration in μmol/L (outliers removed)"
              },
              "sd": {
                "type": "number",
                "description": "Standard deviation in μmol/L (outliers removed)"
              },
              "median": {
                "type": "number",
                "description": "Median concentration in μmol/L (outliers removed)"
              },
              "cv": {
                "type": "number",
                "description": "Coefficient of Variation percentage (outliers removed)",
                "minimum": 0
              },
              "rcv": {
                "type": "number",
                "description": "Percent Reference Change Value (outliers removed)",
                "minimum": 0
              }
            }
          }
        }
      }
    }
  }
}
